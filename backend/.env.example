# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=rate-my-groupmates

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Google sign-in: OAuth "Web application" client id from Google Cloud Console
# (APIs & Services > Credentials). Add your frontend URLs as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Signs login sessions. Required in production; use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=

# Local testing only: sign in as any name + email without Google. Always off in production.
DEV_LOGIN=true
