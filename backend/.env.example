# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=rate-my-groupmates

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Optional: Google sign-in. Leave empty to offer email + password only. To turn it on, create an
# OAuth "Web application" client id in Google Cloud Console and add your frontend URLs as
# Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Signs login sessions. Required in production (Vercel); use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
